{
  "name": "qa-web-agent",
  "version": "0.1.0",
  "description": "Interfaz web local que convierte una frase en castellano en un test de Playwright ejecutado y en verde, vía el SDK de Claude.",
  "type": "module",
  "license": "MIT",
  "author": "Nicolascarames",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nicolascarames/Agente-QA-Web.git"
  },
  "homepage": "https://github.com/Nicolascarames/Agente-QA-Web#readme",
  "bugs": {
    "url": "https://github.com/Nicolascarames/Agente-QA-Web/issues"
  },
  "keywords": ["qa", "testing", "playwright", "gherkin", "bdd", "claude", "agent", "e2e"],
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "qa-web-agent": "bin/agente-qa.mjs",
    "agente-qa": "bin/agente-qa.mjs"
  },
  "files": [
    "bin",
    "dist-client",
    "dist-server",
    "skill",
    "scripts/bienvenida.mjs",
    "README.md",
    "!dist-server/**/*.test.*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/comprobar-estilos.mjs && node scripts/limpiar-dist-server.mjs && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "empezar": "node bin/agente-qa.mjs iniciar",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "postinstall": "node scripts/bienvenida.mjs",
    "postprepare": "node scripts/bienvenida.mjs --dev"
  },
  "overrides": {
    "rolldown": "1.2.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-rnd": "^10.4.13"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.1",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
