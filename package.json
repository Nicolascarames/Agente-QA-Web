{
  "name": "agente-qa-web",
  "version": "0.1.0",
  "description": "Interfaz web local que convierte una frase en castellano en un test de Playwright ejecutado y en verde, vía el SDK de Claude.",
  "type": "module",
  "license": "MIT",
  "author": "Nicolascarames",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "agente-qa": "bin/agente-qa.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/comprobar-estilos.mjs && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run"
  },
  "overrides": {
    "rolldown": "1.2.3"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.268",
    "@fastify/static": "^8.1.1",
    "fastify": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-rnd": "^10.4.13"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.1",
    "postcss": "^8.5.1",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
