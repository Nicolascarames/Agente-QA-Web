// Config aparte, no composite: `catalogo.test.ts`/`catalogo.cli-vivo.test.ts` cruzan a propósito
// de `src/` (el catálogo editorial) a `server/` (comandoLibre.ts, cli.ts) para probar la lógica
// real de parseo y localización sin reimplementarla en el test. `tsconfig.app.json`/`server.json`
// son "composite": exigen listar cada fichero alcanzado por import en su propio "include", así
// que este par de tests no encajaba en ninguno de los dos sin arrastrar medio `server/` al bundle
// de cliente (o viceversa). Este tercer tsconfig no es composite, así que basta con listar los dos
// ficheros raíz: TS resuelve sus imports transitivos sin exigir que también estén en "include".
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/catalogo/catalogo.test.ts", "src/catalogo/catalogo.cli-vivo.test.ts"]
}
